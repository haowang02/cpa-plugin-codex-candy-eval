# Copy to .env and fill in private values. Never commit the populated .env.
CPA_SSH_HOST='your-ssh-alias'

# Paths are relative to the remote SSH user's home directory.
CPA_REMOTE_PLUGIN_DIR='path/to/plugins/linux/amd64'
CPA_REMOTE_COMPOSE_FILE='path/to/docker-compose.yaml'

CPA_BASE_URL='https://example.invalid'
CPA_MANAGEMENT_PASSWORD=''
